{
  "name": "pexpacks-supplies",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:webpack": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "build": "next build --webpack",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "lint": "eslint . && tsc --noEmit",
    "db:link": "node scripts/ensure-supabase-linked.cjs",
    "security:preflight": "node scripts/check-admin-session-secret.cjs",
    "capacity:preflight": "node scripts/check-distributed-rate-limit.cjs",
    "payment:sandbox:preflight": "node scripts/check-payment-sandbox-readiness.cjs",
    "db:lint": "supabase db lint --local --schema public --level warning --fail-on error",
    "check:images": "node scripts/check-image-budget.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:design": "node scripts/design-system-audit.cjs",
    "audit:perf": "node scripts/performance-audit.cjs",
    "check:preview": "node scripts/check-preview-env.cjs",
    "check:all": "node scripts/quality-gate.cjs",
    "test": "vitest run",
    "test:db": "supabase test db",
    "test:e2e": "playwright test",
    "test:visual": "playwright test e2e/visual",
    "test:visual:update": "playwright test e2e/visual --update-snapshots",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "analyze": "cross-env ANALYZE=true next build",
    "db:smoke": "node scripts/db-performance-smoke.cjs",
    "ai:converter:smoke": "node scripts/ai-list-converter-smoke.cjs",
    "db:storage:report": "node scripts/db-storage-report.cjs",
    "db:security:advisors": "node scripts/db-security-advisor.cjs",
    "db:preflight": "npm run db:link && node scripts/db-schema-preflight.cjs && npm run db:smoke",
    "db:reconcile:audit": "node scripts/db-reconciliation-audit.cjs",
    "school:verify": "node scripts/verify-school-catalog.cjs",
    "db:archive:dry-run": "node scripts/archive-operational-history.cjs",
    "db:archive": "node scripts/archive-operational-history.cjs --execute",
    "admin:smoke": "node scripts/admin-browser-smoke-test.cjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.72",
    "@ai-sdk/react": "^4.0.105",
    "@google/generative-ai": "^0.24.1",
    "@react-pdf/renderer": "^4.8.1",
    "@sentry/nextjs": "^10.74.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-table": "9.2.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^1.2.0",
    "ai": "^7.0.102",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "heic2any": "^0.0.4",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "papaparse": "^5.6.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "resend": "^6.12.4",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/bundle-analyzer": "^16.2.6",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.0",
    "prettier": "^3.6.2",
    "read-excel-file": "^9.3.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
