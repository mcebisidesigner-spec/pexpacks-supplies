# ─── Supabase ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Dedicated high-entropy HMAC secret for the signed admin browser-session gate.
ADMIN_SESSION_SECRET=generate-a-random-32-plus-character-secret

# Transaction Pooler (Port 6543 with ?pgbouncer=true) for serverless app runtime
DATABASE_URL=postgres://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct Connection (Port 5432) strictly for CLI database migrations
DIRECT_URL=postgres://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# SMTP email delivery for internal Next.js form endpoints
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Pexpacks Website
SMTP_TO_EMAIL=
SMTP_REPLY_TO_EMAIL=

# Optional per-form recipients
SMTP_CONTACT_TO_EMAIL=
SMTP_ORDERS_TO_EMAIL=
SMTP_QUOTES_TO_EMAIL=
SMTP_PARTNERSHIPS_TO_EMAIL=
SMTP_OFFICE_PACKS_TO_EMAIL=


# Distributed rate limiting for Vercel multi-instance traffic (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Heavy Catalog Caching & Background Queues (Redis Cloud)
REDIS_URL=
# Site
NEXT_PUBLIC_SITE_URL=https://pexpacks.co.za
# Optional non-public fallback for origin checks
SITE_URL=https://pexpacks.co.za
NEXT_PUBLIC_PEXPACKS_WHATSAPP_NUMBER=0780036048

# Google Search Console verification
NEXT_PUBLIC_GOOGLE_VERIFICATION=

NEXT_PUBLIC_SITE_URL=https://Pexpacks.co.za

# Ozow payment gateway (Happy Pay BNPL)
OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
OZOW_API_KEY=
# Set to true only for Ozow test mode; omit entirely for live payments
OZOW_IS_TEST=false
# Public app URL used for Ozow return/notify URLs
NEXT_PUBLIC_APP_URL=https://pexpacks.co.za

# Receipt emails (purchase receipts sent after successful payment via Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Pexpacks <orders@pexpacks.co.za>
RESEND_REPLY_TO_EMAIL=orders@pexpacks.co.za

# Supabase Database Webhook Secret (Header verification for x-supabase-webhook-secret)
SUPABASE_WEBHOOK_SECRET=your-randomly-generated-32-char-secret

# Vercel Cron authentication (required for /api/cron/reconciliation)
CRON_SECRET=replace-with-a-random-32-character-secret

# Sentry error monitoring (leave unset locally; configure in Vercel Production)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
