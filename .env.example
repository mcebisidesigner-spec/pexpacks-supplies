# ─── Supabase ───
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SMTP email delivery for internal Next.js form endpoints
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Pexpacks Website
SMTP_TO_EMAIL=
SMTP_REPLY_TO_EMAIL=

# Optional per-form recipients
SMTP_CONTACT_TO_EMAIL=
SMTP_ORDERS_TO_EMAIL=
SMTP_QUOTES_TO_EMAIL=
SMTP_PARTNERSHIPS_TO_EMAIL=
SMTP_OFFICE_PACKS_TO_EMAIL=

# Site
NEXT_PUBLIC_SITE_URL=https://pexpacks.co.za
# Optional non-public fallback for origin checks
SITE_URL=https://pexpacks.co.za
NEXT_PUBLIC_PEXPACKS_WHATSAPP_NUMBER=

# Google Search Console verification
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# ─── Paystack Payment Gateway ───
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=https://Pexpacks.co.za

# ─── Supabase (additional) ───
# Required for webhook updates (service role — server-only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=
